# BASELINE CONGELADO — DSpark + PP=2, 19/ago/2026
#
# Esta e' a UNICA configuracao que ja subiu com draft: escada_dspark_w4a4.sh em
# 16,48 / 8192, com 15.454 tokens de KV e concorrencia de 1,89x.
#
# Existe como ARQUIVO, e nao como paragrafo num registro, porque a causa das
# quatro falhas da equivalencia nao foi arquitetura: foi rodar sem querer uma
# configuracao diferente da que funciona. Prosa nao impede isso; default impede.
#
#   . "$(dirname "$0")/baseline_congelado.env"
#
# Cada variavel usa ${VAR:-...}, entao exportar a variavel ANTES continua
# sobrescrevendo. O default e' o baseline, nao uma prisao:
#
#   export MAX_MODEL_LEN=10240; . baseline_congelado.env    # funciona
#   MAX_MODEL_LEN=10240 . baseline_congelado.env            # NAO funciona
#
# A segunda forma e' pior do que "nao pega", e por isso vale a explicacao:
#
#   MAX_MODEL_LEN=10240 . baseline_congelado.env
#     dentro, antes do export:   10240
#     dentro, depois do export:  10240
#     DEPOIS do source:          <indefinida>
#
# O valor E' visto durante o source, o `export` interno chega a assumi-lo, e
# mesmo assim tudo desaparece quando o builtin retorna: o bash fora do modo posix
# restaura o estado anterior a' atribuicao prefixada, export inclusive. Ou seja,
# a forma errada FUNCIONA no lugar onde voce olharia para conferir e falha no
# lugar onde o script usa a variavel. Testado acima, nao suposto.
#
# ATENCAO A PART: ela NAO e' um botao neutro de memoria. O drafter consome cinco
# taps do alvo, target_layer_ids = [4, 16, 28, 40, 52]. Em 16,48 a fronteira cai
# depois da camada 15, entao exatamente UM tap (o 4) fica no estagio 0 e quatro
# no estagio 1. Em 20,44 ou 24,40 passam a ser dois e tres. Mudar a particao
# muda quais hidden states atravessam a fronteira -- que e' o mecanismo que a
# equivalencia greedy existe para validar. Reparticionar e' um EXPERIMENTO
# PROPRIO, com equivalencia e performance refeitas, nunca um ajuste no meio de
# outro teste.

# --- alvo: vence com cache quente, que e' o caso do agente de codigo ---
export MODEL_PATH="${MODEL_PATH:-/workspace/models/awq-w4a16}"
export QUANTIZATION="${QUANTIZATION-}"          # vazio = infere do checkpoint

# --- drafter: ConvRot W4A4, 1,3 G. O bf16 tem 2,6 G e custou 2,09 GiB no PP1 ---
export DRAFT_PATH="${DRAFT_PATH:-/workspace/models/dspark-qwen38-w4a4}"

# --- k=7 e' o block_size declarado NESTE checkpoint, nao um limite do vLLM ---
#     k<7  nao assumir valido nem invalido por teoria; testar so' com motivo
#     k=14 nao assumir "dois blocos = melhor"; exige benchmark
export NUM_SPECULATIVE_TOKENS="${NUM_SPECULATIVE_TOKENS:-7}"

# --- estagio 0 e' a 3080 Ti com CUDA_VISIBLE_DEVICES=1,0 ---
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-1,0}"
export PIPELINE_PARALLEL_SIZE="${PIPELINE_PARALLEL_SIZE:-2}"
export VLLM_PP_LAYER_PARTITION="${VLLM_PP_LAYER_PARTITION:-16,48}"

# --- 8192 subiu; 16384 nao coube. A escada 10k/12k/14k mantem esta particao ---
export MAX_MODEL_LEN="${MAX_MODEL_LEN:-8192}"
export GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.88}"
export KV_CACHE_MEMORY_BYTES="${KV_CACHE_MEMORY_BYTES-}"   # UM traco: vazio = dimensione

# --- multimodal DESLIGADO pela flag, nao pelos limites ---
# As duas portas parecem equivalentes -- o proprio docstring de language_model_only
# diz "Equivalent to setting --limit-mm-per-prompt to 0 for every modality" -- e
# nao sao:
#
#   --limit-mm-per-prompt '{"image":0,"video":0}'
#       supports_multimodal_inputs() -> False, roda text-only
#       ModelConfig.compute_hash: limit_mm_per_prompt esta em ignored_factors
#       qwen3_next.py:323 text_only -> False, kernel fundido DESLIGADO
#
#   --language-model-only
#       supports_multimodal_inputs() -> False, roda text-only
#       ModelConfig.compute_hash: entra como factors["language_model_only"]
#       qwen3_next.py:323 text_only -> True, kernel fundido LIGADO
#
# O caminho pelos limites custou uma rodada: um artefato compilado com multimodal
# LIGADO foi servido a um boot com ele DESLIGADO, mesma chave, e o grafo carregado
# pediu .size() de um None. E, de quebra, a sessao inteira rodou com o kernel
# fundido de QK-norm+RoPE+gate desligado nas 16 camadas de full-attention.
#
# Os dois pulam o profiling do encoder, que era o objetivo original (6,39 -> 5,52
# GiB no estagio 0). A torre de visao e' construida de qualquer jeito: qwen3_5.py
# monta self.visual sem condicao nenhuma.
export LANGUAGE_MODEL_ONLY="${LANGUAGE_MODEL_ONLY:-1}"
export LIMIT_MM_PER_PROMPT="${LIMIT_MM_PER_PROMPT-}"   # UM traco: vazio = fabrica

# --- a equivalencia usa uma requisicao; 2 e' o que a escada mediu ---
export MAX_NUM_SEQS="${MAX_NUM_SEQS:-2}"

# --- ver o comentario de LANGUAGE_MODEL_ONLY: a chave do cache tem buracos, e
#     um par A/B que varia k nao pode arriscar reusar grafo entre as rodadas ---
export VLLM_DISABLE_COMPILE_CACHE="${VLLM_DISABLE_COMPILE_CACHE:-1}"

# ---------------------------------------------------------------------------
# Imprime o baseline RESOLVIDO. Carregar o arquivo nao basta: daqui a tres dias
# alguem le so' o nome do script e assume a configuracao. O log tem que dizer o
# que rodou, e o resultado tem que carregar isso junto.
#
# REGRA OPERACIONAL: este banner e' parte OBRIGATORIA da evidencia. Numero sem a
# configuracao resolvida que apareceu antes do boot nao e' medicao, e' boato.
# "Deu 73 tok/s" so' vale acompanhado do bloco. Sem isso e' impossivel saber, uma
# semana depois, se aquilo veio do baseline atual ou de uma config anterior --
# que e' exatamente a classe de erro que custou quatro rodadas desta sessao.
#
#   baseline_mostrar                 # so' na tela
#   baseline_mostrar "$OUT"          # tela + anexado ao arquivo de resultado
baseline_mostrar() {
  local destino="${1:-}"
  local texto
  texto=$(cat <<FIM
=== BASELINE RESOLVIDO ===
TARGET=${MODEL_PATH}
DRAFT=${DRAFT_PATH}
QUANT=${QUANTIZATION:-<inferida do checkpoint>}
PP=${PIPELINE_PARALLEL_SIZE}
PART=${VLLM_PP_LAYER_PARTITION}
LEN=${MAX_MODEL_LEN}
K=${NUM_SPECULATIVE_TOKENS}
UTIL=${GPU_MEMORY_UTILIZATION}
KV_BYTES=${KV_CACHE_MEMORY_BYTES:-<dimensionar>}
LANG_ONLY=${LANGUAGE_MODEL_ONLY:-<nao: multimodal LIGADO>}
LIMIT_MM=${LIMIT_MM_PER_PROMPT:-<fabrica>}
MAX_NUM_SEQS=${MAX_NUM_SEQS}
COMPILE_CACHE=${VLLM_DISABLE_COMPILE_CACHE:+DESLIGADO}
CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}
==========================
FIM
)
  echo "$texto"
  [ -n "$destino" ] && printf '%s
' "$texto" >> "$destino"
  return 0
}

# ---------------------------------------------------------------------------
# Argumentos -e do docker, montados AQUI e em nenhum outro lugar.
#
# Antes cada script repetia a lista na mao. O resultado previsivel: validar_
# dspark_pp.sh nunca passou DRAFT_PATH e herdou o drafter bf16 por quatro
# rodadas, e duas sondas escritas nesta mesma sessao -- na sessao em que o
# problema foi documentado -- repetiram valores a mao de novo. Um script que
# esquece uma variavel nao quebra: ele roda OUTRA configuracao e entrega um
# numero. Por isso a lista tem um dono so.
#
#   baseline_docker_args        # usa NUM_SPECULATIVE_TOKENS corrente
#   baseline_docker_args 0      # sobrescreve k so' nesta chamada (rodada sem draft)
#
# Preenche o array BASELINE_DOCKER_ARGS. Array, e nao string, porque
# LIMIT_MM_PER_PROMPT carrega aspas e um $(...) sem aspas quebraria nelas.
baseline_docker_args() {
  local k="${1:-$NUM_SPECULATIVE_TOKENS}"
  BASELINE_DOCKER_ARGS=(
    -e "MODEL_PATH=$MODEL_PATH"
    -e "QUANTIZATION=$QUANTIZATION"
    -e "DRAFT_PATH=$DRAFT_PATH"
    -e "NUM_SPECULATIVE_TOKENS=$k"
    -e "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
    -e "PIPELINE_PARALLEL_SIZE=$PIPELINE_PARALLEL_SIZE"
    -e "VLLM_PP_LAYER_PARTITION=$VLLM_PP_LAYER_PARTITION"
    -e "MAX_MODEL_LEN=$MAX_MODEL_LEN"
    -e "MAX_NUM_SEQS=$MAX_NUM_SEQS"
    -e "GPU_MEMORY_UTILIZATION=$GPU_MEMORY_UTILIZATION"
    -e "KV_CACHE_MEMORY_BYTES=$KV_CACHE_MEMORY_BYTES"
    -e "LANGUAGE_MODEL_ONLY=$LANGUAGE_MODEL_ONLY"
    -e "LIMIT_MM_PER_PROMPT=$LIMIT_MM_PER_PROMPT"
    -e "VLLM_DISABLE_COMPILE_CACHE=$VLLM_DISABLE_COMPILE_CACHE"
  )
}

# Volumes idem: o plugin do disco TEM de cobrir o da imagem. A copia embutida na
# qwen38-pp-dspark:0.27.1 e' anterior ao despacho por op opaca e ainda pega um
# threading.Lock dentro do apply do linear, o que mata o Dynamo ao compilar o
# drafter ConvRot. sweep_gemm montava e nunca viu; validar nao montava e morreu.
#   baseline_docker_mounts "$(cd /c/Users/USER/w4a4 && pwd -W)"
baseline_docker_mounts() {
  local raiz="$1"
  BASELINE_DOCKER_MOUNTS=(
    -v vllm-cache:/root/.cache/vllm
    -v triton-cache:/root/.triton
    -v "${raiz}/models:/workspace/models:ro"
    -v "${raiz}/docker:/opt/qwen38/docker:ro"
    -v "${raiz}/plugin/qwen_w4a4_vllm:/usr/local/lib/python3.12/dist-packages/qwen_w4a4_vllm:ro"
  )
}
